{
  "name": "changesets-gitlab",
  "version": "0.14.0",
  "type": "module",
  "repository": "https://github.com/un-ts/changesets-gitlab.git",
  "author": "JounQin <admin@1stg.me> (https://www.1stG.me)",
  "funding": "https://opencollective.com/changesets-gitlab",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.11 || ^24 || >=26"
  },
  "bin": "lib/cli.js",
  "main": "./lib/index.cjs",
  "types": "./index.d.cts",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "module-sync": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.d.cts",
    "lib"
  ],
  "keywords": [
    "@changesets/cli",
    "auto-release",
    "changelog",
    "changeset",
    "changesets",
    "ci",
    "gitlab",
    "release",
    "release-automation",
    "release-plz"
  ],
  "scripts": {
    "build": "run-p 'build:*'",
    "build:r": "r -f cjs",
    "build:ts": "tsc -p tsconfig.lib.json",
    "cli": "tsx src/cli",
    "format": "prettier --write .",
    "lint": "run-p 'lint:*'",
    "lint:es": "eslint . --cache",
    "lint:tsc": "tsc --noEmit",
    "prepare": "simple-git-hooks && yarn-berry-deduplicate -s fewer || exit 0",
    "release": "yarn build && clean-pkg-json && changeset publish",
    "test": "vitest run",
    "typecov": "type-coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@changesets/assemble-release-plan": "^7.0.0",
    "@changesets/config": "^4.0.1",
    "@changesets/errors": "^1.0.0",
    "@changesets/parse": "^1.0.0",
    "@changesets/pre": "^3.0.0",
    "@changesets/read": "^1.0.1",
    "@gitbeaker/rest": "^43.8.0",
    "@manypkg/get-packages": "^3.1.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "global-agent": "^4.1.3",
    "human-id": "^4.2.1",
    "markdown-table": "^3.0.4",
    "mdast-util-to-string": "^4.0.0",
    "micromatch": "^4.0.8",
    "p-limit": "^7.3.2",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "resolve-from": "^5.0.0",
    "semver": "^7.8.5",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@1stg/common-config": "^15.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@pkgr/rollup": "^7.1.0",
    "@types/global-agent": "^3.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/web": "^0.0.356",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "clean-pkg-json": "^2.0.0",
    "eslint": "^10.10.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.0.0",
    "size-limit-preset-node-lib": "^0.4.0",
    "tsx": "^4.23.13",
    "type-coverage": "^2.30.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yarn-berry-deduplicate": "^6.1.3"
  },
  "resolutions": {
    "prettier": "^3.5.3"
  },
  "typeCoverage": {
    "atLeast": 100,
    "cache": true,
    "detail": true,
    "ignoreAsAssertion": true,
    "ignoreNested": true,
    "ignoreNonNullAssertion": true,
    "showRelativePath": true,
    "strict": true,
    "update": true
  }
}
